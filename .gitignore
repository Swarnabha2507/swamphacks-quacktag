# .env and nessie_ids.json are committed on purpose so teammates share the
# same Nessie key and demo account. Keep this repo PRIVATE.
__pycache__/
# Last accepted counter for each key (written by server.py while it runs)
key_counters.json

# PlatformIO build output and the firmware secret (KEY_SECRET lives in .env too)
firmware/**/.pio/
firmware/**/include/secrets.h
# Pump pairings and the cached gas merchant (written by server.py)
pairings.json
local_state.json
