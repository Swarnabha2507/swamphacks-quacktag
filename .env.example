# Copy this file to .env and fill it in.

# Capital One Nessie key: log in with GitHub at https://prod.nessieisreal.com
NESSIE_API_KEY=paste-your-key-here
# Optional: change if Capital One gives you a different base URL.
# NESSIE_BASE=https://api.nessieisreal.com

# Auth0 Single Page Application (public values, not secrets). Leave blank to use the demo login.
# Find them in Auth0 Dashboard → Applications → your SPA → Settings.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=

# Shared with the key device firmware (firmware/quacktag_key/include/secrets.h): signs the
# rotating key codes (docs/KEY_FORMAT.md). Leave blank to accept key codes without checking them.
KEY_SECRET=
# PIN for the fake debit card at the gas pump (website/pump.html)
CARD_PIN=1234
